{
  "openapi": "3.1.0",
  "info": {
    "title": "rustashop-api",
    "description": "Actix-web commerce API (OpenAPI via utoipa)",
    "contact": {
      "name": "Interchouette"
    },
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "crate::health"
        ],
        "summary": "`GET /healthz` handler.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [],
        "summary": "`GET /openapi.json` handler.",
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "OpenAPI document"
          }
        }
      }
    },
    "/v1/products": {
      "get": {
        "tags": [
          "crate::products"
        ],
        "summary": "Lists enabled products.",
        "operationId": "list_products",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows (capped).",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/{id}": {
      "get": {
        "tags": [
          "crate::products"
        ],
        "summary": "Returns one product by id.",
        "operationId": "get_product",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Product id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "description": "JSON error body.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Machine-readable error."
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "description": "JSON body for `GET /healthz`.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Liveness status."
          }
        }
      },
      "ProductListResponse": {
        "type": "object",
        "description": "List payload for `GET /v1/products`.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductResponse"
            },
            "description": "Page of products."
          }
        }
      },
      "ProductResponse": {
        "type": "object",
        "description": "Product JSON returned by catalog routes.",
        "required": [
          "id",
          "slug",
          "name",
          "enabled"
        ],
        "properties": {
          "category_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional category id."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional long description."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the product is offered for sale."
          },
          "id": {
            "type": "string",
            "description": "Stable identifier."
          },
          "name": {
            "type": "string",
            "description": "Display name."
          },
          "slug": {
            "type": "string",
            "description": "Unique URL slug."
          }
        }
      }
    }
  }
}
# Copy to .env for local overrides (never commit .env).
# Host `make run-api` uses 127.0.0.1. Compose sets RUSTASHOP_BIND=0.0.0.0:8080 on the api service.
DATABASE_URL=postgres://rustashop:rustashop@127.0.0.1:5432/rustashop
RUSTASHOP_BIND=127.0.0.1:8080
# Admin bearer for /v1/{RUSTASHOP_ADMIN_API_PREFIX}/* (also accepted as ADMIN_API_TOKEN). Unset => 401.
# RUSTASHOP_ADMIN_API_TOKEN=dev-admin-token
# Operator API URI segment (default `admin` for local only). Set a non-guessable value on installs.
# RUSTASHOP_ADMIN_API_PREFIX=bk-change-me
